<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D16"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📷 Scan Pairing QR"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Point camera at the QR code displayed in your terminal by 'klip pair'"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <!-- Barcode Scanner View with Built-in Viewfinder and Camera Engine -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/barcodeScannerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />


    <Button
        android:id="@+id/btnCancelScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter Token / IP Manually"
        android:backgroundTint="#1E293B"
        android:textColor="#E2E8F0"
        android:layout_marginTop="16dp" />

</LinearLayout>
