<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Klip"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Clipboard sync between your own devices"
            android:textColor="#8B5CF6"
            android:textSize="14sp" />

        <!-- Live status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#131B2E"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:text="Starting…"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#8B5CF6"
            android:text="Scan a QR code to link a device"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnShowQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#1E293B"
            android:text="Show a QR code for another device"
            android:textColor="#E2E8F0" />

        <Button
            android:id="@+id/btnPaste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#1E293B"
            android:text="Paste a ticket instead"
            android:textColor="#E2E8F0" />

        <Button
            android:id="@+id/btnSendNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#10B981"
            android:text="Send my clipboard now"
            android:textColor="#04210F" />

        <Switch
            android:id="@+id/switchRelays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="Work across different networks (uses n0 relay servers)"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Relays see which devices talk and when, never what you copy. Turn off for same-Wi-Fi only."
            android:textColor="#64748B"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#1E293B"
            android:text="Automatic copy from this phone (setup)"
            android:textColor="#E2E8F0" />

        <Button
            android:id="@+id/btnTestBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#1E293B"
            android:text="Test: can this phone paste from the background?"
            android:textColor="#E2E8F0" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#1E293B"
            android:text="Allow background activity (battery)"
            android:textColor="#E2E8F0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="End-to-end encrypted • no account • alpha"
            android:textColor="#475569"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
